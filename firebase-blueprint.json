{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "bio": { "type": "string" },
        "website": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "Post": {
      "title": "Post",
      "description": "A feed post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "content": { "type": "string" },
        "image": { "type": "string" },
        "voice": { "type": "string" },
        "timestamp": { "type": "number" },
        "likes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "userId": { "type": "string" },
              "userName": { "type": "string" },
              "content": { "type": "string" },
              "timestamp": { "type": "number" }
            },
            "required": ["id", "userId", "userName", "content", "timestamp"]
          }
        }
      },
      "required": ["id", "userId", "userName", "content", "timestamp", "likes", "comments"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "content": { "type": "string" },
        "image": { "type": "string" },
        "voice": { "type": "string" },
        "timestamp": { "type": "number" },
        "triggeredBy": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "content", "timestamp"]
    },
    "Location": {
      "title": "Location",
      "description": "User location for the map",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "userName", "lat", "lng", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Feed posts"
    },
    "messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Chat messages"
    },
    "locations/{locationId}": {
      "schema": { "$ref": "#/entities/Location" },
      "description": "User locations"
    }
  }
}
